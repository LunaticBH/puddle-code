        "ServerAliveCountMax=3",
        "alice@devbox",
        "--",
        "sh -c 'if command -v journalctl >/dev/null 2>&1 && journalctl --user -u puddled -n 1 >/dev/null 2>&1; then journalctl --user -u puddled -n 200 --no-pager; elif [ -f \"${PUDDLE_HOME:-$HOME/.puddle}\"/logs/puddled.out.log ]; then tail -n 200 \"${PUDDLE_HOME:-$HOME/.puddle}\"/logs/puddled.out.log \"${PUDDLE_HOME:-$HOME/.puddle}\"/logs/puddled.err.log 2>/dev/null; else echo '\\''no daemon logs found — the daemon logs to its supervisor (journalctl --user -u puddled / ~/.puddle/logs)'\\''; fi'"
      ]
    }
  ],
